<UserControl
  x:Class="TempAndHumiTest.Views.MonitorView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:model="clr-namespace:TempAndHumiTest.Models"
  xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
  xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel,
                                     IsDesignTimeCreatable=False}"
  HorizontalContentAlignment="Stretch"
  VerticalContentAlignment="Stretch"
>
  <UserControl.Resources>
    <Style x:Key="RS" TargetType="ToggleButton">
      <Setter Property="Width" Value="auto" />
      <Setter Property="Background" Value="#9FFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Name="root" Background="#1000" CornerRadius="9">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Border Name="txGrid" Width="33" Height="17" Background="#FFF" CornerRadius="8.5">
                  <Grid>
                    <TextBlock
                      Margin="5,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      FontSize="9"
                      Foreground="White"
                      Text="开"
                    />
                    <TextBlock
                      Margin="5,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      FontSize="9"
                      Foreground="Gray"
                      Text="关"
                    />
                    <Ellipse
                      Name="Ellipse"
                      Width="15"
                      Height="15"
                      Margin="1,0"
                      HorizontalAlignment="Left"
                      Fill="#DDD"
                    />
                  </Grid>
                </Border>

                <ContentPresenter
                  Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                />
              </Grid>
            </Border>
            <!--这里相当于事件了，前端里面的 click、mouseover 等-->
            <ControlTemplate.Triggers>
              <!--鼠标移到上面-->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="root" Property="Background" Value="#2000" />
                <Setter Property="Cursor" Value="Hand" />
              </Trigger>
              <!--被选中 = 正在采集-->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="txGrid" Property="Background" Value="Orange" />
                <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Ellipse" Property="Fill" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- 根 Grid 不写 Width/Height，跟着父容器的 * 行自动铺满 -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
      <RowDefinition Height="45" />
    </Grid.RowDefinitions>

    <!-- 页头 -->
    <Border Grid.Row="0" Padding="16,5" BorderThickness="0,0,0,1">
      <Border.BorderBrush>
        <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8">
          <GradientStop Offset="0.5" Color="Transparent" />
          <GradientStop Offset="0" Color="#1FDCF5" />
        </RadialGradientBrush>
      </Border.BorderBrush>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  启停开关：IsChecked 单向绑定，状态只由 IsStartMonitor 决定，
                      避免 ToggleButton 自己翻转后再和命令里的判断打架  -->
        <ToggleButton
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Command="{Binding ToggleMonitorCommand}"
          Content="监控"
          IsChecked="{Binding IsStartMonitor, Mode=OneWay}"
          Style="{StaticResource RS}"
        />

        <!-- 标题 -->
        <TextBlock
          Grid.Column="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontFamily="{StaticResource AllFont}"
          FontSize="24"
          FontWeight="Black"
          Foreground="#87E8EC"
          Text="温湿度实时检测系统"
        />

        <!-- 汇总状态 -->
        <StackPanel
          Grid.Column="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal"
        >
          <Ellipse
            Width="10"
            Height="10"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Fill="{Binding SummaryColor}"
          />
          <TextBlock
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{Binding SummaryColor}"
            Text="{Binding SummaryMessage}"
          />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 从站卡片区：一个从站一张卡，不再把 1 号从站的数值画两遍 -->
    <Border Grid.Row="1" Margin="10,0" Background="#1000" CornerRadius="5">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#87E8EC" />
          <GradientStop Offset="0.3" Color="Transparent" />
          <GradientStop Offset="0.8" Color="Transparent" />
          <GradientStop Offset="1" Color="#87E8EC" />
        </LinearGradientBrush>
      </Border.BorderBrush>

      <!--这里本来是准备两个从站的，但是我手上只有一个收发器-->

      <Grid Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 卡片页头：从站名 + 通信状态 -->
        <StackPanel Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock
            VerticalAlignment="Center"
            FontSize="18"
            Foreground="White"
            Text="{Binding Slave.Title}"
          />
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#87E8EC"
            Text="{Binding Slave.StatusText}"
          />
        </StackPanel>

                <StackPanel Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Width="20" Height="20" Background="#E53935" CornerRadius="5"/>
                    <TextBlock Text="温度" Margin="5,0,10,0" Foreground="White" VerticalAlignment="Center"/>

                    <Border Width="20" Height="20" Background="#1976D2" CornerRadius="5"/>
                    <TextBlock Text="湿度" Margin="5,0,10,0" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

        <!-- 仪表 -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="1" Grid.Column="0" BorderBrush="#87E8EC" BorderThickness="0.5">
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Orientation="Horizontal"
            >
              <model:GaugeControl
                Width="240"
                Height="240"
                Margin="0,0,16,0"
                Maximum="70"
                Minimum="-40"
                ProgressBrush="#FF5722"
                TickStep="10"
                Title="温度"
                TrackBrush="#E0E0E0"
                Unit="℃"
                Value="{Binding Slave.Temperature}"
              />
              <model:GaugeControl
                Width="240"
                Height="240"
                Maximum="80"
                Minimum="20"
                ProgressBrush="#00BCD4"
                TickStep="10"
                Title="湿度"
                TrackBrush="#E0E0E0"
                Unit="%"
                Value="{Binding Slave.Humidity}"
              />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" BorderBrush="#87E8EC" BorderThickness="0.5">
            <lvc:CartesianChart Background="Transparent"
              Series="{Binding Series}"
              YAxes="{Binding YAxes}" 
              XAxes="{Binding XAxes}"                  
            >

            </lvc:CartesianChart>
          </Border>
        </Grid>

        <!-- 报警文案 -->
        <TextBlock
          Grid.Row="2"
          Margin="0,6"
          HorizontalAlignment="Center"
          FontSize="13"
          Foreground="{Binding Slave.StatusColor}"
          Text="{Binding Slave.AlarmMessage}"
        />
      </Grid>
    </Border>

    <!-- 底部状态 -->
    <Grid Grid.Row="2" Margin="10,0">
      <TextBlock
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="#5FFF"
        Text="{Binding ConnectionStatus}"
      />
      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="#3FFF"
        Text="{Binding SampleIntervalText}"
      />
      <TextBlock
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="#3FFF"
      >
        <Run Text="@ZhaoJf Made Co.ltd" />
        <Run Text="  " />
        <Run Text="2026-10-23" />
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>
