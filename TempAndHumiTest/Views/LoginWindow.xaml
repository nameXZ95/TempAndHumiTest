<Window x:Class="TempAndHumiTest.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TempAndHumiTest.Views"
        xmlns:com="clr-namespace:TempAndHumiTest.Common"
        mc:Ignorable="d"
        Background="#1A1E27"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="13"
        Title="登陆" Height="450" Width="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid KeyDown="EnterKeyDownEvent">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition />
        </Grid.RowDefinitions>
            <!--不加上背景的话，拖拽就实现不了-->
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
               
                <TextBlock Text="温湿度监控系统" FontSize="22" Foreground="White" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Normal" />

                <Button
                    Content="✕" HorizontalAlignment="Right"
                    Foreground="#AAAAAA"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="50" Height="50"
                    FontSize="16"
                    IsCancel="True"
                    Cursor="Hand" />

                <Grid Grid.Row="0" Height="10" VerticalAlignment="Bottom" Margin="0,0,0,-5">

                    <!-- 底层散射光晕 (模糊效果) -->
                    <Ellipse Width="300" Height="10" VerticalAlignment="Bottom">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#00C8FF" Offset="0.5" />
                                <!-- 中心青色 -->
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <BlurEffect Radius="15" />
                            <!-- 增大Radius可以让散射更柔和 -->
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 底层散射光晕 (加强中心亮度) -->
                    <Ellipse Width="150" Height="4" VerticalAlignment="Bottom">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#61E4FF" Offset="0.5" />
                                <!-- 更亮的光 -->
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <BlurEffect Radius="6" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 顶部的锐利高光线 (模拟原图最亮的那条线) -->
                    <Rectangle Width="80" Height="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#E0FBFF" Offset="0.5" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- 贯穿两侧的底部分割线 -->
                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#1A4A7A" Offset="0" />
                                <GradientStop Color="#00C8FF" Offset="0.5" />
                                <GradientStop Color="#1A4A7A" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

            </Grid>
     


        <Border Grid.Row="1" Width="400" Height="300">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="账号登陆" FontSize="24" Foreground="White" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="Normal" />

                <StackPanel Grid.Row="1" Margin="0,0,10,-43">
                    <TextBox Style="{StaticResource TechTextBox}" x:Name="UserBox" Text="{Binding Account}" Margin="20,20" />
                    <PasswordBox Style="{StaticResource TechPasswordBox}" x:Name="PwdBox"  Margin="20,0" />
                    <CheckBox Content="记住密码" Style="{StaticResource TechCheckBox}" VerticalAlignment="Center"
                              Margin="20,15" />
                    <Button Content="登陆" Margin="10" Width="120" Style="{StaticResource TechButton}" Click="LoginClick"  />
                    <TextBlock Grid.Row="10" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="White"
                               Margin="0,5">
                        <Hyperlink Command="{Binding OpernLogPathCommand}">注册账号></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>