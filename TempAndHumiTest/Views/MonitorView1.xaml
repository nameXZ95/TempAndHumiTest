<UserControl x:Class="TempAndHumiTest.Views.MonitorView1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TempAndHumiTest.Views"
             xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel, IsDesignTimeCreatable=False}"
             
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             Width="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  引入字典资源，RadioButton 的定制样式  -->
                <ResourceDictionary Source="/Assets/Styles/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <!--第一行，头部，展示页面标题以及按钮-->
        <Border Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#87E8EC" />
                    <GradientStop Offset="1" Color="#87E8EC" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="数据监控" Margin="10,0" Foreground="White" FontSize="22" FontWeight="Normal"
                    VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                     VerticalAlignment="Center">
                    <Button Style="{StaticResource TopBtnStyle}" Command="{Binding QueryLogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                         Margin="5,0"
                         Foreground="White"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource RF}"
                         FontSize="18"
                         Text="&#xe63b;" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                         Margin="5,0"
                         Foreground="White"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource RF}"
                         FontSize="18"
                         Text="&#xe634;" />
                            <TextBlock Text="导出" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="Reset" Style="{StaticResource TopBtnStyle}" Command="{Binding ResetQueryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                         Margin="5,0"
                         Foreground="White"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource RF}"
                         FontSize="18"
                         Text="&#xe618;" />
                            <TextBlock Text="参数设置" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Border>

       
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!--第二行，第一列，设备列表-->
            <Border Background="Transparent" CornerRadius="5" Margin="10" BorderThickness="0.5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#87E8EC" />
                        <GradientStop Offset="1" Color="#87E8EC" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="设备列表" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="15,0"/>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False"
                          Background="Transparent"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizing="True"
                          ScrollViewer.CanContentScroll="True">
                        <!--设置表格的颜色样式，就是一些警告等级的-->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#87E8EC" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                           
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Resources>
                        <Style x:Key="LogCellTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="TextDecorations" Value="{x:Null}" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#87E8EC" />
                            <!-- 将 ToolTip 绑定到单元格自身的内容 -->
                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="#87E8EC" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E3A4A" />
                            <Setter Property="Foreground" Value="#87E8EC" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="#165C72" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备id" Width="80"/>
                            <DataGridTextColumn Header="状态" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <!-- 默认色 -->
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="离线">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="在线">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <!-- 绿 -->
                                            </DataTrigger>
                                            
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="温度" Width="65"/>
                            <DataGridTextColumn Header="湿度" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <!--第二行，第二列，温湿度趋势-->
            <Border Background="Transparent" Grid.Column="1" CornerRadius="5" Margin="10" BorderThickness="0.5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#87E8EC" />
                        <GradientStop Offset="1" Color="#87E8EC" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="温湿度趋势" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0"/>

                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="20" Height="20" Background="#E53935" CornerRadius="5"/>
                            <TextBlock Text="温度" Margin="5,0,10,0" Foreground="White" VerticalAlignment="Center"/>

                            <Border Width="20" Height="20" Background="#1976D2" CornerRadius="5"/>
                            <TextBlock Text="湿度" Margin="5,0,10,0" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#87E8EC" BorderThickness="0.5">
                        <lvc:CartesianChart Background="Transparent"
                          Series="{Binding Series}"
                          YAxes="{Binding YAxes}" 
                          XAxes="{Binding XAxes}"/>
                    </Border>
                    
                </Grid>
            </Border>
            <!--第二行第三列，实时数据-->
            <Border Background="Transparent" Grid.Column="2" CornerRadius="5" Margin="10" BorderThickness="0.5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#87E8EC" />
                        <GradientStop Offset="1" Color="#87E8EC" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="实时数据" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0"/>
                    <Border Grid.Row="1" BorderBrush="#87E8EC" BorderThickness="0.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="75,10" >
                                <Ellipse Width="12" Height="12" Fill="#51e2e7" Margin="10,0" />
                                <TextBlock FontSize="26" VerticalAlignment="Center">
                                    <Run Text="26.3" FontWeight="Black" Foreground="#4cf585"/>
                                    <Run Text="℃" Foreground="#51e2e7" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="75,6,15,15">
                                <Ellipse Width="12" Height="12" Fill="#51e2e7" Margin="10,0"/>
                                <TextBlock FontSize="26" VerticalAlignment="Center">
                                    <Run Text="63.4%" FontWeight="Black" Foreground="#4cf585"/>
                                    <Run Text="RH" Foreground="#51e2e7" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="#87E8EC" BorderThickness="0.5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,20">
                                <TextBlock Text="设备ID:" FontSize="14" Foreground="White" Margin="30,0"/>
                                <TextBlock Text="S01-001" FontSize="14" Foreground="White" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,20">
                                <TextBlock Text="采样时间:" FontSize="14" Foreground="White" Margin="30,0"/>
                                <TextBlock Text="2026-10-30 12:06:33" FontSize="14" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border> 
                </Grid>
            </Border>
            
        </Grid>

        <Border Grid.Row="2" Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#87E8EC" />
                    <GradientStop Offset="1" Color="#87E8EC" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="温湿度阈值" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="15,0"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#87E8EC" BorderThickness="0.5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="#ff212f" Margin="10,0"/>
                                <TextBlock Text="温度上限" TextAlignment="Center" FontSize="16" Foreground="White"/>
                            </StackPanel>
                            <TextBlock TextAlignment="Center" FontSize="16" Foreground="White">
                                <Run Text="{Binding TempAndHumiLimtModel.TempMax}"/>
                                <Run Text="℃"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="#87E8EC" BorderThickness="0.5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="Gray" Margin="10,0" />
                                <TextBlock Text="温度下限" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                            </StackPanel>
                            <TextBlock TextAlignment="Center" FontSize="16" Foreground="White">
                                <Run Text="{Binding TempAndHumiLimtModel.TempMin}"/>
                                <Run Text="℃"/>   
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#87E8EC" BorderThickness="0.5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="#fd262d" Margin="10,0" />
                                <TextBlock Text="湿度上限" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                            </StackPanel>
                            <TextBlock TextAlignment="Center" FontSize="16" Foreground="White">
                                <Run Text="{Binding TempAndHumiLimtModel.HumiMax}"/>
                                <Run Text="%RH"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="#87E8EC" BorderThickness="0.5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Fill="#fd8017" Margin="10,0" />
                                <TextBlock Text="湿度下限" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                            </StackPanel>
                            <TextBlock TextAlignment="Center" FontSize="16" Foreground="White">
                                 <Run Text="{Binding TempAndHumiLimtModel.HumiMin}"/>
                                 <Run Text="%RH"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            
        </Border>
        
    </Grid>
</UserControl>
