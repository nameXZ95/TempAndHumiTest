<UserControl x:Class="TempAndHumiTest.Views.UserManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TempAndHumiTest.Views"
             xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UserManageViewModel,IsDesignTimeCreatable=False}"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             Width="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  引入字典资源，RadioButton 的定制样式  -->
                <ResourceDictionary Source="/Assets/Styles/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="120" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--第一行，头部，展示页面标题以及按钮-->
        <Border Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#87E8EC" />
                    <GradientStop Offset="1" Color="#87E8EC" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="用户管理" Margin="10,0" Foreground="White" FontSize="22" FontWeight="Normal"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="Reset" Style="{StaticResource TopBtnStyle}" Command="{Binding ResetQueryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                Foreground="White"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RF}"
                                FontSize="18"
                                Text="＋" />
                            <TextBlock Text="新增用户" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                Foreground="White"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RF}"
                                FontSize="18"
                                Text="&#xe63b;" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                Foreground="White"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RF}"
                                FontSize="18"
                                Text="&#xe634;" />
                            <TextBlock Text="导出" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

        </Border>
        <!--用户统计-->
        <UniformGrid Columns="4" Width="1200" Grid.Row="1" HorizontalAlignment="Center">
            <Border Margin="20,10" Background="#232834"
                    BorderBrush="#363D4D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="80" Height="80" Fill="Black" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="用户总数" FontSize="22" FontWeight="Normal" Foreground="White" />
                        <TextBlock Text="14" FontSize="22" FontWeight="Normal" Foreground="#e7fb74" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="20,10" Background="#232834"
                    BorderBrush="#363D4D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="80" Height="80" Fill="Black" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="管理员" FontSize="22" FontWeight="Normal" Foreground="White" />
                        <TextBlock Text="2" FontSize="22" FontWeight="Normal" Foreground="#e7fb74" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="20,10" Background="#232834"
                    BorderBrush="#363D4D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="80" Height="80" Fill="Yellow" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="操作员" FontSize="22" FontWeight="Normal" Foreground="White" />
                        <TextBlock Text="8" FontSize="22" FontWeight="Normal" Foreground="#e7fb74" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="20,10" Background="#232834"
                    BorderBrush="#363D4D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="80" Height="80" Fill="White" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="访客" FontSize="22" FontWeight="Normal" Foreground="White" />
                        <TextBlock Text="5" FontSize="22" FontWeight="Normal" Foreground="#e7fb74" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="Transparent" CornerRadius="5" Margin="10" BorderThickness="0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#87E8EC" />
                    <GradientStop Offset="1" Color="#87E8EC" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="账号列表" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="15,0" />
                <DataGrid Grid.Row="1" AutoGenerateColumns="False"
                          ItemsSource="{Binding Path=LoginUserModels, Mode=TwoWay}"
                          Background="Transparent"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizing="True"
                          ScrollViewer.CanContentScroll="True">

                    <!--设置表格的颜色样式，就是一些警告等级的-->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#87E8EC" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />

                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Resources>
                        <Style x:Key="LogCellTextStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="TextDecorations" Value="{x:Null}" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#87E8EC" />
                            <!-- 将 ToolTip 绑定到单元格自身的内容 -->
                            <Setter Property="ToolTip"
                                    Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="#87E8EC" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E3A4A" />
                            <Setter Property="Foreground" Value="#87E8EC" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="#165C72" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户名" />
                        <DataGridTextColumn Header="姓名">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333333" />
                                    <!-- 默认色 -->
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="离线">
                                            <Setter Property="Foreground" Value="Gray" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="在线">
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                            <!-- 绿 -->
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="角色" />
                        <DataGridTextColumn Header="部门" />
                        <DataGridTextColumn Header="状态" />
                        <DataGridTextColumn Header="最后登陆时间" />
                        <DataGridTemplateColumn Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="禁用" Foreground="OrangeRed" />
                                        <Button Content="启用" Foreground="LightGreen" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>