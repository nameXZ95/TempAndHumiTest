<UserControl
    x:Class="TempAndHumiTest.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TempAndHumiTest.Views"
    xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:com="clr-namespace:TempAndHumiTest.Common"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"

    Width="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  引入字典资源，RadioButton 的定制样式  -->
                <ResourceDictionary Source="/Assets/Styles/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LogTabToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#94D9E6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="18,8" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="15,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 选中状态 -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#00D8B6" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                                <!-- 鼠标悬浮 -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="#104E5F" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#87E8EC" />
                    <GradientStop Offset="1" Color="#87E8EC" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="日志记录" Margin="10,0" Foreground="White" FontSize="22" FontWeight="Normal"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TopBtnStyle}" Command="{Binding QueryLogCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                Foreground="White"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RF}"
                                FontSize="18"
                                Text="&#xe63b;" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                Foreground="White"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RF}"
                                FontSize="18"
                                Text="&#xe634;" />
                            <TextBlock Text="导出Excel" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="Reset" Style="{StaticResource TopBtnStyle}" Command="{Binding ResetQueryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0"
                                Foreground="White"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RF}"
                                FontSize="18"
                                Text="&#xe63a;" />
                            <TextBlock Text="清空筛选" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--第二行第一列，展示表单信息，就是筛选条件的-->
            <Border Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#87E8EC" />
                        <GradientStop Offset="1" Color="#87E8EC" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="日志类型:" Foreground="#B0E4F0" FontSize="14" Margin="5,5,0,8"
                                   VerticalAlignment="Center" />
                        <!-- 切换按钮组容器 -->
                        <Border CornerRadius="6" BorderBrush="#165C72" BorderThickness="1" Background="Transparent"
                                Padding="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ToggleButton x:Name="btnCollectLog" IsChecked="{Binding IsCollection}"
                                              Style="{StaticResource LogTabToggleStyle}" Content="采集日志" />
                                <ToggleButton x:Name="btnAlarmLog" IsChecked="{Binding IsAlarm}"
                                              Style="{StaticResource LogTabToggleStyle}"
                                              Content="告警日志" />
                                <ToggleButton x:Name="btnOperateLog" IsChecked="{Binding IsOperation}"
                                              Style="{StaticResource LogTabToggleStyle}"
                                              Content="操作日志" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="时间范围:" Foreground="#B0E4F0" FontSize="14" Margin="5,5,0,8"
                                   VerticalAlignment="Center" />
                        <!-- 时间范围 -->
                        <Border CornerRadius="6" BorderBrush="#165C72" BorderThickness="1" Background="Transparent"
                                Padding="2">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <hc:DateTimePicker VerticalAlignment="Center"
                                                   Style="{StaticResource DateTimePickerPlus}"
                                                   Text="{Binding StartTime, Mode=TwoWay}"
                                                   hc:InfoElement.ShowClearButton="True" />
                                <TextBlock Text="至" Margin="5,0" Foreground="#94D9E6" FontSize="14"
                                           VerticalAlignment="Center" />
                                <hc:DateTimePicker x:Name="EP" hc:InfoElement.ShowClearButton="True"
                                                   Style="{StaticResource DateTimePickerPlus}"
                                                   Text="{Binding EndTime, Mode=TwoWay}" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <TextBlock Text="设备编号:" Foreground="#B0E4F0" FontSize="14" Margin="5,5,0,8"
                                   VerticalAlignment="Center" />
                        <!-- 时间范围 -->
                        <Border CornerRadius="6" BorderBrush="#165C72" Margin="10,0,10,5" BorderThickness="1"
                                Background="Transparent" Padding="2">
                            <ComboBox Width="200" ItemsSource="{Binding ItemNums}" SelectedValue="{Binding ItemNum}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <TextBlock Text="报警等级:" Foreground="#B0E4F0" FontSize="14" Margin="5,5,0,8"
                                   VerticalAlignment="Center" />
                        <!-- 时间范围 -->
                        <Border CornerRadius="6" BorderBrush="#165C72" Margin="10,0,10,5" BorderThickness="1"
                                Background="Transparent" Padding="2">
                            <ComboBox Width="200" ItemsSource="{Binding AlarmLevels}" SelectedValue="{Binding Level}" />
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>


            <Border Grid.Column="1" Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#87E8EC" />
                        <GradientStop Offset="1" Color="#87E8EC" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding LogModels}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizing="True"
                              ScrollViewer.CanContentScroll="True">
                        <!--设置表格的颜色样式，就是一些警告等级的-->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="#87E8EC" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <!--<Style.Triggers>
                                    <DataTrigger Binding="{Binding LogLevel}" Value="3">
                                        <Setter Property="Background" Value="OrangeRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LogLevel}" Value="2">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                </Style.Triggers>-->
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style x:Key="LogCellTextStyle" TargetType="{x:Type TextBlock}">
                                <Setter Property="TextDecorations" Value="{x:Null}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="#87E8EC" />
                                <!-- 将 ToolTip 绑定到单元格自身的内容 -->
                                <Setter Property="ToolTip"
                                        Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="#87E8EC" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E3A4A" />
                                <Setter Property="Foreground" Value="#87E8EC" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="#165C72" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding RowNumber}"
                                                ElementStyle="{StaticResource LogCellTextStyle}" Width="60" />
                            <DataGridTextColumn Header="记录时间" ElementStyle="{StaticResource LogCellTextStyle}"
                                                Binding="{Binding Created, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                Width="180" />
                            <DataGridTextColumn Header="设备ID" ElementStyle="{StaticResource LogCellTextStyle}"
                                                Foreground="White" Binding="{Binding SlaveId}" Width="80" />
                            <DataGridTextColumn Header="温度℃" ElementStyle="{StaticResource LogCellTextStyle}"
                                                Foreground="White" Binding="{Binding Temperature}"
                                                Width="100" />
                            <DataGridTextColumn Header="湿度％RH" ElementStyle="{StaticResource LogCellTextStyle}"
                                                Binding="{Binding Humidity}" Width="100" />
                            <DataGridTextColumn Header="警报等级"
                                                Binding="{Binding LogLevel}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#333333" />
                                        <!-- 默认色 -->
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogLevel}" Value="Debug">
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LogLevel}" Value="Info">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                <!-- 绿 -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LogLevel}" Value="Warning">
                                                <Setter Property="Foreground" Value="#F9A825" />
                                                <!-- 橙黄 -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LogLevel}" Value="Error">
                                                <Setter Property="Foreground" Value="#D32F2F" />
                                                <!-- 红 -->
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" ElementStyle="{StaticResource LogCellTextStyle}"
                                                Binding="{Binding State}" Width="120" />
                            <DataGridTextColumn Header="备注" ElementStyle="{StaticResource LogCellTextStyle}"
                                                Binding="{Binding Remark}" Width="200" />
                        </DataGrid.Columns>

                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="转到" Foreground="White" Margin="5" VerticalAlignment="Center" />
                        <TextBox x:Name="PageNumberBox"
                                 Width="60"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="PageNumberBox_PreviewTextInput"
                                 DataObject.Pasting="PageNumberBox_Pasting"
                                 KeyDown="PageNumberBox_KeyDown"
                                 LostFocus="PageNumberBox_LostFocus">
                            <TextBox.Text>
                                <Binding Path="CurrentPage"
                                         UpdateSourceTrigger="Explicit"
                                         ValidatesOnExceptions="True">
                                    <Binding.ValidationRules>
                                        <com:PageRangeValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding GoToPageCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="页" Foreground="White" VerticalAlignment="Center" Margin="5,0" />
                        <Button Content="GO" VerticalAlignment="Center" Margin="5,0"
                                Command="{Binding GoToPageCommand}" />
                        <Button Name="btnUp" Content="上一页" Command="{Binding LastPageCommand}"
                                VerticalAlignment="Center" Margin="5,0" />
                        <Button Name="btnNext" Content="下一页" Command="{Binding NextPageCommand}"
                                VerticalAlignment="Center" Margin="5,0" />
                        <TextBlock Height="20" Foreground="White" VerticalAlignment="Center">
                            <TextBlock Text="【共" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontWeight="Black"
                                       Text="{Binding TotalPages}" />
                            <TextBlock Text="页】" VerticalAlignment="Center" />
                            <TextBlock Text="【当前" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Foreground="Red" FontWeight="Black"
                                       Text="{Binding CurrentPage}" />
                            <TextBlock Text="页】" VerticalAlignment="Center" />
                        </TextBlock>
                        <TextBlock Text="总条数：" Foreground="White" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalCount}" Height="20" VerticalAlignment="Center" Foreground="Red"
                                   FontWeight="Black" />
                    </StackPanel>
                </Grid>


            </Border>


        </Grid>
    </Grid>
</UserControl>