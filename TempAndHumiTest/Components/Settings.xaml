<Window x:Class="TempAndHumiTest.Components.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TempAndHumiTest.Components"
        xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
        xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
        xmlns:com="clr-namespace:TempAndHumiTest.Common"
        mc:Ignorable="d"
        WindowStyle="None"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel,IsDesignTimeCreatable=False}"
        Background="#1A1E27"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        FontSize="13"
        Title="系统设置">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  引入字典资源，RadioButton 的定制样式  -->
                <ResourceDictionary Source="/Assets/Styles/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border Background="#1A1E29"
                BorderBrush="#2C3E50"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>


                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <!-- 头部高度 -->
                    <RowDefinition Height="*" />
                    <!-- 内容区域 -->
                </Grid.RowDefinitions>
                <!-- ======= 头部区域 ======= -->
                <Border Grid.Row="0"
                        CornerRadius="8"
                        Background="#232834"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    
                    <!-- 用来实现拖拽 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- 标题部分 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 关闭按钮部分 -->
                        </Grid.ColumnDefinitions>
                        <Border Height="5" VerticalAlignment="Bottom" >
                            <Border.Background>
                                <RadialGradientBrush RadiusX="0.7">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.3"/>
                                    <GradientStop Color="#0FFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 标题文本 -->
                        <TextBlock Text="参数设置"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0" />

                        <!-- 关闭按钮 -->
                        <Button Grid.Column="1"
                                Content="✕"
                                Foreground="#AAAAAA"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="50" Height="50"
                                FontSize="16"
                                IsCancel="True"
                                Cursor="Hand" />
                        <!-- 这里可以用 Style 给按钮加个鼠标移入变红/变亮的悬停效果 -->
                    </Grid>
                </Border>
                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="55" />
                    </Grid.RowDefinitions>
                    <!--第一个设置项-->
                    <Border Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#87E8EC" />
                                <GradientStop Offset="1" Color="#87E8EC" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="常规设置" VerticalAlignment="Center" FontWeight="Black" Margin="20,0"
                                       FontSize="14"
                                       Foreground="White" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <!-- 左右两列的间距 -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧区域 -->
                                <StackPanel Grid.Column="0">

                                    <!-- 第 2 行 -->
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="采样周期：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- 输入框自适应 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 单位自适应文字宽度 -->
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding AppSettings.AppSettingModel.CollectTime}"
                                                     Width="245" Height="28" VerticalContentAlignment="Center" />

                                            <!-- 单位文本放在右侧 -->
                                            <TextBlock Grid.Column="1" Text="秒"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#888888" />
                                            <!-- 单位通常用灰色显示 -->
                                        </Grid>
                                    </Grid>
                                    <!-- 第 3 行 -->
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="语言：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <ComboBox Grid.Column="1" Width="254" Margin="25,0,0,0" Height="28"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding LanguageList}"
                                                  SelectedValue="{Binding AppSettings.AppSettingModel.Language}">

                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- 右侧区域 -->
                                <StackPanel Grid.Column="2">
                                    <!-- 第 1 行 -->

                                    <!-- 第 2 行 -->
                                    <Grid Margin="5,15,15,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="数据保存周期：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />

                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- 输入框自适应 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 单位自适应文字宽度 -->
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding AppSettings.AppSettingModel.DataSaveTime}"
                                                     Height="28" Width="245" VerticalContentAlignment="Center" />

                                            <!-- 单位文本放在右侧 -->
                                            <TextBlock Grid.Column="1" Text="天"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="white" />
                                            <!-- 单位通常用灰色显示 -->
                                        </Grid>

                                        <!--<TextBox Grid.Column="1" Width="255" HorizontalAlignment="Right" Text="30 天" Margin="10,0,0,0" Height="28" VerticalContentAlignment="Center"/>-->
                                    </Grid>

                                    <!--<Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="主题颜色：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />

                                    </Grid>-->
                                </StackPanel>
                            </Grid>
                        </Grid>


                    </Border>
                    <!--告警设置-->
                    <Border Grid.Row="1" Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#87E8EC" />
                                <GradientStop Offset="1" Color="#87E8EC" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="告警设置" VerticalAlignment="Center" Margin="20,0" FontSize="14"
                                       Foreground="White"
                                       FontWeight="Black" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <!-- 左右两列的间距 -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧区域 -->
                                <StackPanel Grid.Column="0">

                                    <!-- 第 2 行 -->
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="温度上限：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- 输入框自适应 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 单位自适应文字宽度 -->
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding AppSettings.TempAndHumiLimtModel.TempMax}" Width="245" Height="28"
                                                     VerticalContentAlignment="Center" />

                                            <!-- 单位文本放在右侧 -->
                                            <TextBlock Grid.Column="1" Text="℃"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="White" />
                                            <!-- 单位通常用灰色显示 -->
                                        </Grid>
                                    </Grid>
                                    <!-- 第 3 行 -->
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="温度下限：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- 输入框自适应 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 单位自适应文字宽度 -->
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding AppSettings.TempAndHumiLimtModel.TempMin}" Width="245" Height="28"
                                                     VerticalContentAlignment="Center" />

                                            <!-- 单位文本放在右侧 -->
                                            <TextBlock Grid.Column="1" Text="℃"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="White" />
                                            <!-- 单位通常用灰色显示 -->
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <!-- 右侧区域 -->
                                <StackPanel Grid.Column="2">
                                    <!-- 第 1 行 -->

                                    <!-- 第 2 行 -->
                                    <Grid Margin="5,15,15,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="湿度上限：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- 输入框自适应 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 单位自适应文字宽度 -->
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding AppSettings.TempAndHumiLimtModel.HumiMax}" Width="245" Height="28"
                                                     VerticalContentAlignment="Center" />

                                            <!-- 单位文本放在右侧 -->
                                            <TextBlock Grid.Column="1" Text="%RH"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="White" />
                                            <!-- 单位通常用灰色显示 -->
                                        </Grid>
                                    </Grid>

                                    <Grid Margin="5,15,15,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="湿度下限：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- 输入框自适应 -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- 单位自适应文字宽度 -->
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding AppSettings.TempAndHumiLimtModel.HumiMin}" Width="245" Height="28"
                                                     VerticalContentAlignment="Center" />

                                            <!-- 单位文本放在右侧 -->
                                            <TextBlock Grid.Column="1" Text="%RH"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="White" />
                                            <!-- 单位通常用灰色显示 -->
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>


                    </Border>

                    <Border Grid.Row="2" Background="Transparent" CornerRadius="5" Margin="5" BorderThickness="0.5">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#87E8EC" />
                                <GradientStop Offset="1" Color="#87E8EC" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="串口设置" VerticalAlignment="Center" Margin="20,0" FontSize="14"
                                       Foreground="White"
                                       FontWeight="Black" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <!-- 左右两列的间距 -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧区域 -->
                                <StackPanel Grid.Column="0">

                                    <!-- 第 2 行 -->
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="串口名称" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <ComboBox Grid.Column="1" Width="254" Height="28"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding PortNameList}"
                                              SelectedValue="{Binding AppSettings.PortModel.PortName}"/>
                                    </Grid>
                                    <!-- 第 3 行 -->
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="数据位：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <TextBox Grid.Column="1" Text="{Binding AppSettings.PortModel.DataBits}" Width="254" Height="28"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <!-- 右侧区域 -->
                                <StackPanel Grid.Column="2">
                                    <!-- 第 1 行 -->

                                    <!-- 第 2 行 -->
                                    <Grid Margin="5,15,15,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="波特率：" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />

                                        <ComboBox Grid.Column="1" Width="254" Height="28"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding BaudRateList}"
                                              SelectedValue="{Binding AppSettings.PortModel.BaudRate}"/>

                                    </Grid>


                                </StackPanel>
                            </Grid>
                        </Grid>


                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="35,0">
                        <Button Content="取消" Cursor="Hand" IsCancel="True" FontSize="14" Background="#102e48" BorderBrush="Transparent" Foreground="White" Width="80" Height="35" FontWeight="Normal" Margin="20,0"/>
                        <Button Content="确定" FontSize="14"  Width="80"  Height="35" Command="{Binding SaveCommand}" FontWeight="Normal" Cursor="Hand" Margin="10,0" Background="#0ff9ec" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>