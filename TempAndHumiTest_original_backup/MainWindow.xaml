<Window x:Class="TempAndHumiTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
        xmlns:view="clr-namespace:TempAndHumiTest.Views"
        xmlns:local="clr-namespace:TempAndHumiTest"
        mc:Ignorable="d"
        Language="zh-CN"
        Title="MainWindow" Height="650" Width="1200" 
        Background="#02517a"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei" 
        FontSize="12" FontWeight="ExtraLight" ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <!--无边框-->
        <WindowChrome CaptionHeight="50" CornerRadius="5" GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>

        <ResourceDictionary>
            
            <ResourceDictionary.MergedDictionaries>
                <!--  引入字典资源，RadioButton的制定样式  -->
                <ResourceDictionary Source="/Assets/Styles/AppStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 第一行的按钮-->
        <Image Source="/Assets/Images/监控.png" VerticalAlignment="Center"  HorizontalAlignment="Left" Width="40" Height="40" Margin="10,0"/>
        <TextBlock Text="温湿度监控系统" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="65,0"
                   FontSize="18" FontWeight="Black"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Cursor="">
            <RadioButton Style="{StaticResource RaBtnStyle}" Cursor="Hand" IsChecked="True" CommandParameter="MonitorView" Command="{Binding NavigateCommand}">
                <RadioButton.Content>
                    <StackPanel>
                        <TextBlock Text="&#xe61d;" FontFamily="{StaticResource RF}" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="监控"/>
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
            <RadioButton Style="{StaticResource RaBtnStyle}" CommandParameter="LogView" Command="{Binding NavigateCommand}">
                <RadioButton.Content>
                    <StackPanel>
                        <TextBlock Text="&#xe619;" FontFamily="{StaticResource RF}" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="日志"/>
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
            <RadioButton Style="{StaticResource RaBtnStyle}" CommandParameter="DataView" Command="{Binding NavigateCommand}" Cursor="Hand">
                <RadioButton.Content>
                    <StackPanel>
                        <TextBlock Text="&#xe61c;" FontFamily="{StaticResource RF}" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="数据"/>
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
        <RadioButton Style="{StaticResource RaBtnStyle}" Cursor="Hand" CommandParameter="UserManageView" Command="{Binding NavigateCommand}">
                <RadioButton.Content>
                    <StackPanel>
                        <TextBlock Text="&#xe614;" FontFamily="{StaticResource RF}" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="管理"/>
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BtnStyle}" Margin="10,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="&#xe618;" FontFamily="{StaticResource RF}" FontSize="22" HorizontalAlignment="Center" Margin="0,5"/>
                    <TextBlock Text="设置"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource BtnStyle}" Command="{Binding ExitCommand}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="&#xe61a;" FontSize="22" FontFamily="{StaticResource RF}"  HorizontalAlignment="Center" Margin="0,5"/>
                    <TextBlock Text="退出"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!--第二行的配件-->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
            <TextBlock Text="欢迎登陆: " FontSize="14" FontFamily="{StaticResource AllFont}" Foreground="#5FFF"/>
            <TextBlock Text="Admin" FontSize="14" FontFamily="{StaticResource AllFont}" Foreground="#87E8EC"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,20,0">
            <TextBlock Text="今天时间： " FontSize="14" FontFamily="{StaticResource AllFont}" Foreground="#5FFF"/>
            <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:yyyy年MM月dd日 dddd}}" FontSize="14" FontFamily="{StaticResource AllFont}" Foreground="#87E8EC"/>
        </StackPanel>
        
        <!--第三行，各个页面的展示-->
        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}"/>
        <view:MonitorView Grid.Row="2" d:Visibility="Visible" Visibility="Collapsed" />
    </Grid>
</Window>
