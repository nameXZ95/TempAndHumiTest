<UserControl
    x:Class="TempAndHumiTest.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TempAndHumiTest.Views"
    xmlns:vm="clr-namespace:TempAndHumiTest.ViewModels"
    xmlns:model="clr-namespace:TempAndHumiTest.Models"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel,IsDesignTimeCreatable=True}"
    Width="1200"
    MaxHeight="600"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style TargetType="ToggleButton" x:Key="RS">
            <Setter Property="Width" Value="auto"/>
            <Setter Property="Background" Value="#9FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="#1000" CornerRadius="9"  Name="root">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Height="17" Name="txGrid" Width="33" CornerRadius="8.5" Background="#FFF">
                                    <Grid>
                                        <TextBlock Text="开" FontSize="9" Foreground="White" VerticalAlignment="Center" 
                                                   HorizontalAlignment="Left" Margin="5,0"/>
                                        <TextBlock Text="关" FontSize="9" Foreground="Gray" VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right" Margin="5,0"/>
                                        <Ellipse Width="15" Height="15" Fill="#DDD" Margin="1,0" HorizontalAlignment="Left" Name="Ellipse" />
                                    </Grid>
                                </Border>

                                <ContentPresenter Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!--这里相当于事件了，前端里面的click、mouseover等-->
                        <ControlTemplate.Triggers>
                            <!--鼠标移到目前上面的事件-->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#2000"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <!--被选中的事件-->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="txGrid" Property="Background" Value="Orange"/>
                                <Setter TargetName="Ellipse" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Ellipse" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- ✅ 根 Grid 不写 Width/Height，默认 Stretch 填满 -->
    <Grid MaxWidth="1600">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- 左：标题，吃掉剩余 -->
            <ColumnDefinition Width="Auto" />
            <!-- 右：警告，随内容 -->
        </Grid.ColumnDefinitions>
        <!-- 页头背景 + 底边分隔线（可选，但强烈建议） -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" Padding="16,5">
            <Border.BorderBrush>
                <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5, 1" RadiusX="0.8">
                    <GradientStop Offset="0.5" Color="Transparent" />
                    <GradientStop Offset="0" Color="#1FDCF5" />
                </RadialGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton Content="监控" IsChecked="{Binding IsStartMonitor}" Command="{Binding OpenCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource RS}"/>
                <!-- 标题 -->
                <TextBlock
                    Grid.Column="1"
                    Text="温湿度实时检测系统"
                    FontSize="24"
                    FontWeight="Black"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AllFont}"
                    Foreground="#87E8EC"
                    VerticalAlignment="Center" />

                <!-- 警告 -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Monitor.WarmMessage}"
                        FontSize="12"
                        Foreground="{Binding Monitor.WarmColor}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Margin="10,0"
                        Text="{Binding Monitor.WarmIcon}"
                        Foreground="{Binding Monitor.WarmColor}"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource RF}"
                        FontSize="16" />
                </StackPanel>
            </Grid>
        </Border>
        <!--ItemsControl Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>-->
        <Border Background="#1000" Grid.Row="1" Margin="10,0" CornerRadius="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#87E8EC" Offset="0" />
                    <GradientStop Color="Transparent" Offset="0.3" />
                    <GradientStop Color="Transparent" Offset="0.8" />
                    <GradientStop Color="#87E8EC" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="1号从站"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    FontSize="18"
                    Foreground="White" />
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#87E8EC" BorderThickness="0.5">
                   
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <model:GaugeControl Width="280" Height="280" Margin="0,0,20,0"
                                            Title="温度" Unit="℃" Minimum="-40"
                                            Maximum="70"
                                            TickStep="10"
                                            Value="{Binding Monitor.Temperature}"
                                            ProgressBrush="#FF5722"
                                            TrackBrush="#E0E0E0" />
                        <model:GaugeControl Width="280" Height="280"
                                            Title="湿度"
                                            Unit="%"
                                            Minimum="20"
                                            Maximum="80"
                                            TickStep="10"
                                            Value="{Binding Monitor.Humidity}"
                                            ProgressBrush="#00BCD4"
                                            TrackBrush="#E0E0E0" />
                    </StackPanel>
                </Border>
                <TextBlock
    Text="2号从站"
    Margin="10,0"
                    Grid.Row="0" Grid.Column="1"
    VerticalAlignment="Center"
    HorizontalAlignment="Left"
    FontSize="18"
    Foreground="White" />
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#87E8EC" BorderThickness="0.5">
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <model:GaugeControl Width="280" Height="280" Margin="0,0,20,0"
                                            Title="温度" Unit="℃" Minimum="-40"
                                            Maximum="70"
                                            TickStep="10"
                                            Value="{Binding Monitor.Temperature}"
                                            ProgressBrush="#FF5722"
                                            TrackBrush="#E0E0E0" />
                        <model:GaugeControl Width="280" Height="280"
                                            Title="湿度"
                                            Unit="%"
                                            Minimum="20"
                                            Maximum="80"
                                            TickStep="10"
                                            Value="{Binding Monitor.Humidity}"
                                            ProgressBrush="#00BCD4"
                                            TrackBrush="#E0E0E0" />
                    </StackPanel>
                </Border>
                
               
               
            </Grid>
        </Border>
        <TextBlock VerticalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" FontSize="14" Foreground="#3FFF">
             <Run Text="@ZhaoJf Made Co.ltd"/>
             <Run Text=""/>
             <Run Text="2026-10-23"/>
        </TextBlock>
        <!--</DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>-->
    </Grid>
</UserControl>